# Copy to .env.local and fill in
ADMIN_PASSWORD=change-me
# Optional separate signing secret for admin sessions
ADMIN_SECRET=
NEXT_PUBLIC_SITE_URL=https://libasulfakhar.pk
# WhatsApp Business number, international format without +
NEXT_PUBLIC_WHATSAPP=923348322662
# Customer sessions and OTP hashing (required, 16+ random characters)
AUTH_SECRET=change-me-to-a-long-random-string
# Google sign-in (optional). Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PostgreSQL connection (required). Create the user and database first; see README.
DATABASE_URL=postgres://libas:change-me@localhost:5432/libas_ul_fakhar
