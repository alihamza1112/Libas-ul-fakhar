# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
# Use letters and digits only in POSTGRES_PASSWORD (it is placed inside URLs).

# Database
POSTGRES_PASSWORD=change-me-long-random-letters-and-digits
DB_PORT=5434
# Used only while building the app image; must use the same password and DB_PORT
BUILD_DATABASE_URL=postgres://libas:change-me-long-random-letters-and-digits@127.0.0.1:5434/libas

# Store
APP_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=923348322662
ADMIN_PASSWORD=change-me
# 16+ random characters; secures customer sign-in
AUTH_SECRET=change-me-to-a-long-random-string

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
